<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": a zip holding CodePal-Setup-<version>.exe
     (GitHub artifacts are always zips). The files inside the installer were signed by "app". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="CodePal-Setup-*.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
