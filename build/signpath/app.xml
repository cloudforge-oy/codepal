<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the zipped dist/win-unpacked folder.
     Smart App Control checks DLLs and native addons too, so everything PE is signed. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="*.exe" />
      <include path="*.dll" />
      <include path="resources/app/node_modules/**/win32-*/*.node" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
